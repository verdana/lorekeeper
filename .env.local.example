# Prompt language (default: en). Set to zh for Chinese prompts (personal use).
# PROMPT_LANG and VITE_PROMPT_LANG are aliases of the same setting — set
# either one (or both) to zh and every prompt pack switches to Chinese.
# Vite inlines VITE_PROMPT_LANG into the renderer bundle; PROMPT_LANG reaches
# the server directly and the renderer via vite.config.ts `define` (and the
# Electron main process via electron/build.mjs).
VITE_PROMPT_LANG=zh
PROMPT_LANG=zh
